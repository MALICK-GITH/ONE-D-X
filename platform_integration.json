            "feature_columns": [
              "team_home_encoded",
              "team_away_encoded",
              "league_encoded",
              "league_group_encoded",
              "home_form_rate",
              "away_form_rate",
              "home_attack_avg",
              "away_attack_avg",
              "home_defense_avg",
              "away_defense_avg",
              "head_to_head_matches",
              "head_to_head_home_winrate",
              "hour",
              "day_of_week"
            ],
            "encoders": [
              "team_home",
              "team_away",
              "league",
              "league_group"
            ],
            "metrics": {
              "accuracy": 0.8559633027522936,
              "balanced_accuracy": 0.5549916679291016
