            "model_class": "RandomForestClassifier",
            "n_features_in": 14,
            "pipeline_steps": []
          }
        ]
      }
    },
    {
      "method": "POST",
      "path": "/api/predict",
      "purpose": "Full fused prediction response",
      "required_headers": {
        "Content-Type": "application/json"
      },
      "request_schema": {
        "league": "string",
        "homeTeam": "string",
        "awayTeam": "string",
        "home_odds": "number",
        "draw_odds": "number",
        "away_odds": "number",
        "match_datetime": "optional datetime string",
        "home_form_rate": "optional number",
        "away_form_rate": "optional number",
        "home_attack_avg": "optional number",
        "away_attack_avg": "optional number",
        "home_defense_avg": "optional number",
        "away_defense_avg": "optional number",
        "head_to_head_matches": "optional integer",
        "head_to_head_home_winrate": "optional number"
      },
      "constraints": [
        "Do not invent new features.",
        "Do not change column order.",
        "Use the same encoders and preprocessing as training."
      ],
      "response_example": {
        "home_goals": 2,
        "away_goals": 1,
        "total_goals": 3,
        "over_under_2_5": "OVER",
        "score_prediction": "2-1",
        "confidence": 80.0,
        "source": "ONE DELUX AI 2.0"
      }
    },
    {
