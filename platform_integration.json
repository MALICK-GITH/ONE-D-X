  "usage": {
    "description": "Another platform can call these endpoints directly to retrieve predictions and service metadata.",
    "required_headers": {
      "Content-Type": "application/json"
    }
  },
  "navigation": {
    "root": "/",
    "health": "/health",
    "docs": "/docs",
    "openapi": "/openapi.json",
    "integration_manifest": "/platform_integration.json"
  },
  "endpoints": [
    {
      "method": "GET",
      "path": "/",
      "purpose": "Root JSON entrypoint for platform discovery",
      "response_example": {
        "status": "ok",
        "name": "ONE DELUX AI 3.0",
        "version": "3.0.0",
        "docs": "/docs",
        "openapi": "/openapi.json",
        "health": "/api/status",
        "models": "/api/models",
        "predict": "/api/predict",
        "integration_manifest": "/platform_integration.json"
      }
    },
    {
      "method": "GET",
      "path": "/health",
      "purpose": "Simple health check for uptime monitors",
      "response_example": {
        "status": "ok",
        "models_loaded": 4
      }
    },
    {
      "method": "GET",
      "path": "/platform_integration.json",
      "purpose": "Machine-readable integration manifest for other platforms"
    },
    {
      "method": "GET",
      "path": "/docs",
      "purpose": "Interactive Swagger documentation"
    },
    {
      "method": "GET",
      "path": "/openapi.json",
      "purpose": "OpenAPI schema for SDKs and tooling"
    },
    {
      "method": "GET",
      "path": "/api/status",
